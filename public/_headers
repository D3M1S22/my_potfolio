# Response headers for static hosts that read this file (Cloudflare Pages, Netlify).
# HTML is left to the host default (always revalidated) so deploys show up at once.

# Vite output: file names contain a content hash, so they can be cached forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed: cache for a day, serve stale while refreshing for a week
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/projects/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.png
  Cache-Control: public, max-age=86400

# Security headers for every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
